# CLI
# --------------------------------------------------------------------------

def main(argv):
    # arena interface: Q N R M SEED TIME_S OUTFILE
    if len(argv) == 7 and all(not a.startswith('-') for a in argv[:6]):
        q, n, R, M, seed, t = (int(x) for x in argv[:6])
        out = argv[6]
        cores = int(os.environ.get('COVENGINE_CORES', 6))
        quiet = os.environ.get('COVENGINE_QUIET', '0') == '1'
        cell = Cell(q, n, R, M)
        t0 = time.time()

        def log(msg):
            if not quiet:
                print('%7.1fs %s' % (time.time() - t0, msg), flush=True)
        log('cell %s  q^n=%d ball=%d sphere=%d redundancy=%.2f  budget=%ds cores=%d'
            % (cell, cell.qn, cell.V, cell.S, cell.redundancy, t, cores))
        u, path = run(cell, float(t) - max(1.0, 0.03 * t), seed, out, cores, log)
        log('best uncovered = %s  -> %s' % (u, out))
        return 0

    ap = argparse.ArgumentParser(
        description='covengine -- portfolio driver for K_q(n,R) <= M',
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('-q', type=int, required=True)
    ap.add_argument('-n', type=int, required=True)
    ap.add_argument('-R', type=int, required=True)
    ap.add_argument('-M', type=int, required=True)
    ap.add_argument('-t', type=float, default=60.0, help='wall seconds')
    ap.add_argument('-s', '--seed', type=int, default=1)
    ap.add_argument('--in', dest='inpath', help='seed code file')
    ap.add_argument('--out', help='write the best code here')
    ap.add_argument('--cores', type=int, default=None,
                    help='CPU cores for the portfolio (default 6, or --threads)')
    ap.add_argument('--threads', type=int, default=None,
                    help='alias for --cores, for covsearch CLI compatibility')
    ap.add_argument('--quiet', action='store_true')
    # accepted and ignored, so a covsearch command line still parses
    for flag in ('--random-init', '--sa'):
        ap.add_argument(flag, action='store_true', help=argparse.SUPPRESS)
    for flag in ('--cand', '--tabu', '--kick', '--noise', '--iters', '--stall'):
        ap.add_argument(flag, default=None, help=argparse.SUPPRESS)
    a = ap.parse_args(argv)

    cell = Cell(a.q, a.n, a.R, a.M)
    cores = a.cores or a.threads or int(os.environ.get('COVENGINE_CORES', 6))
    out = a.out or os.path.join(tempfile.mkdtemp(prefix='covengine_out_'), 'code.txt')
    t0 = time.time()

    def log(msg):
        if not a.quiet:
            print('%7.1fs %s' % (time.time() - t0, msg), flush=True)

    log('cell %s  q^n=%d ball=%d redundancy=%.2f budget=%.0fs cores=%d'
        % (cell, cell.qn, cell.V, cell.redundancy, a.t, cores))
    extra = [a.inpath] if a.inpath else []
    u, path = run(cell, a.t, a.seed, out, cores, log, extra_seeds=extra)
    el = time.time() - t0
    print('RESULT q=%d n=%d R=%d M=%d uncovered=%d iters=0 kicks=0 time=%.2f '
          'rate=0 engine=covengine' % (a.q, a.n, a.R, a.M, u, el), flush=True)
    return 0 if u == 0 else 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
